# Copia este archivo a .env (ignorado por git) para scripts/sync-obsidian.mjs.
#
# Conexión del rol de SOLO LECTURA obsidian_reader de Supabase (el mismo que usa
# Finanzas-Personales en su .env.sync), por el pooler en modo sesión. Necesita
# permiso sobre plan_progress: supabase/obsidian_reader.sql.
SUPABASE_READER_DB_URL=postgresql://obsidian_reader.TU-PROJECT-REF:TU-CONTRASEÑA@aws-0-TU-REGION.pooler.supabase.com:5432/postgres

# Opcional: otra ruta de bóveda (por defecto la de iCloud "Segundo Cerebro").
# OBSIDIAN_VAULT=/ruta/a/la/boveda
